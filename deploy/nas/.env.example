# Release assets replace this placeholder with their immutable image digest.
RELAY_IMAGE=ghcr.io/davisding/relay-service@sha256:replace-with-release-digest
RELAY_BIND_ADDRESS=127.0.0.1
RELAY_HOST_PORT=8787
RELAY_PUBLIC_URL=http://127.0.0.1:8787
POSTGRES_SUPERUSER_PASSWORD=replace-with-random-password
RELAY_DB_PASSWORD=replace-with-random-password
RELAY_MIGRATOR_PASSWORD=replace-with-random-password
RELAY_APP_PASSWORD=replace-with-random-password
RELAY_BOOTSTRAP_TOKEN=replace-with-one-time-random-token-of-32-or-more-characters
RELAY_ENCRYPTION_KEY=replace-with-64-hex-characters
RELAY_SECURE_COOKIES=false
RELAY_LOG_LEVEL=info
AI_NETWORK_NAME=ai-network
