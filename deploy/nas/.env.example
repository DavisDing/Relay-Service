# Optional settings for docker-compose.settings.example.yaml. No .env needed by default.
# Relay generates local secrets in relay-data; SQLite is the default.
# PostgreSQL fields are optional; use the postgres overlay to pass the URLs.
# Self-testing follows verified main. Versioned Release assets pin their own digest.
RELAY_IMAGE=ghcr.io/davisding/relay-service:latest
RELAY_PUBLIC_URL=
POSTGRES_SUPERUSER_PASSWORD=
RELAY_DB_PASSWORD=
RELAY_MIGRATOR_PASSWORD=
RELAY_APP_PASSWORD=
RELAY_BOOTSTRAP_TOKEN=
RELAY_ENCRYPTION_KEY=
RELAY_SECURE_COOKIES=
RELAY_LOG_LEVEL=info

RELAY_DATABASE_URL=
RELAY_MIGRATION_DATABASE_URL=
